{
  "name": "wot-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web of Trust v3: the store app on the Real Life Trust Protocol (scaffold, not shipped)",
  "scripts": {
    "dev": "VITE_TARGET=harness vite",
    "build:web": "VITE_TARGET=web vite build && node scripts/check-build.mjs dist",
    "build:fdroid": "VITE_TARGET=fdroid vite build --outDir dist-fdroid && node scripts/check-build.mjs dist-fdroid",
    "build:play": "VITE_TARGET=play VITE_DISABLE_LIVE_UPDATE=true vite build --outDir dist-play && node scripts/check-build.mjs dist-play",
    "build:appstore": "VITE_TARGET=appstore VITE_DISABLE_LIVE_UPDATE=true vite build --outDir dist-appstore && node scripts/check-build.mjs dist-appstore",
    "build:harness": "VITE_TARGET=harness vite build --outDir dist-harness",
    "check:build": "node scripts/check-build.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "check:boundaries": "depcruise src harness --config .dependency-cruiser.cjs",
    "check:boundaries:negative": "node scripts/check-boundaries-negative.mjs",
    "test": "vitest run",
    "test:gc": "vitest run --execArgv=--expose-gc -t gc-only",
    "e2e": "playwright test",
    "measure:kdf": "node scripts/measure-kdf.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/clipboard": "^8",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-live-update": "^8.2.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@noble/curves": "^2.0.1",
    "@openvtc/vti-didcomm-js": "0.12.0",
    "@openvtc/vti-tsp-js": "0.3.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@real-life-org/capacitor-zxing-scanner": "^1.1.1",
    "@real-life/trust-protocol": "0.8.0",
    "@scure/bip39": "^2.0.1",
    "capacitor-email-composer": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.0"
  }
}
