<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (fullBackupContent): no app data in any backup, for the reason in
     data_extraction_rules.xml (one writer per device; restoring goes through the magic words). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
