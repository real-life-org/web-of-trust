# Copy to .env on the server (chmod 600). Never commit .env.
# Values marked (secret) come from the sops-encrypted secrets file, see README.

# Public host name; must match the host inside MEDIATOR_DID.
MEDIATOR_HOST=

# The mediator's DID without the did:// prefix, from `did/did.jsonl`
# (state.id of the last line), e.g. did:webvh:<SCID>:mediator.web-of-trust.de
MEDIATOR_DID=

# Admin DID (did:key) printed by mediator-setup, without the did:// prefix.
ADMIN_DID=

# uid/gid that own ./secrets on the server (`id -u timo`, `id -g timo`).
MEDIATOR_UID=
MEDIATOR_GID=

# (secret) Redis password, e.g. `openssl rand -hex 32`.
REDIS_PASSWORD=

# Optional overrides (defaults in docker-compose.yml)
# Redis memory cap; Redis refuses writes beyond it (noeviction). Default 1gb.
REDIS_MAXMEMORY=
# Undelivered-message lifetime in seconds. Default 604800 (7 days). Keep > 259200 (72 h).
MESSAGE_EXPIRY_SECONDS=
# warn | enforce. Default warn.
TRUST_TASK_VERIFICATION=
# "*" or a comma-separated origin allowlist. Default "*".
CORS_ALLOW_ORIGIN=
# Requests per second per authenticated DID; 0 = off. Default 0.
DID_RATE_LIMIT_PER_SECOND=
# Traefik per-IP limit: average requests per second and burst. Defaults 20 / 60.
RATE_LIMIT_AVERAGE=
RATE_LIMIT_BURST=
